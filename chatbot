#Preprocessing
def preprocess_input(user_input):
    user_input = user_input.lower()
    user_input = re.sub(r'[^\w\s]', '', user_input)  # Remove punctuation
    return user_input

#Function
def get_response(user_input):
    user_input = preprocess_input(user_input)

    for intent, data in intents.items():
        for pattern in data['patterns']:
            if user_input == preprocess_input(pattern):
                return random.choice(data['responses'])

    return "I'm sorry, I didn't understand that. Can you ask something else?"

#loop
def chat():
    print("Chatbot: Hello! How can I assist you with your travel plans today?")
    while True:
        user_input = input("You: ")
        if user_input.lower() in ["bye", "exit", "quit"]:
            print("Chatbot: Goodbye! Have a safe journey!")
            break
        response = get_response(user_input)
        print(f"Chatbot: {response}")

if __name__ == "__main__":
    chat()
